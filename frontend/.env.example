# Configuración del frontend. Copiá este archivo como .env (no se versiona) y cambiá lo que quieras.
# Vite lo lee al compilar (npm run build) y al levantar el entorno local (npm run dev).

# El nombre del curso: aparece arriba de cada página, en la pestaña del navegador y al instalar la
# app en el celular. Si lo dejás vacío se usa "Curso de vibe coding".
VITE_NOMBRE_CURSO=Curso de vibe coding

# El nombre corto que se ve debajo del ícono en el celular (mejor de 12 letras o menos).
# Si lo dejás vacío se usa "Vibe coding".
VITE_NOMBRE_CORTO=Vibe coding
