# Plantilla del sitio de nginx del curso: queda en /etc/nginx/sites-available/vibe-tutor (enlazado
# en sites-enabled). desplegar.sh reemplaza __DOMINIO__ por VIBE_DOMINIO, la instala junto con
# nginx-vibe-tutor-cabeceras.conf, prueba la configuración y recarga nginx solo si cambió.
# Es el archivo completo tal como queda después de certbot: el certificado tiene que existir antes
# del primer despliegue (lo pide deploy/preparar-servidor.sh con certbot --nginx -d <dominio>).
server {
    server_name __DOMINIO__;

    root /var/www/vibe-tutor;
    index index.html;
    client_max_body_size 16m;

    include snippets/vibe-tutor-cabeceras.conf;

    location /api/ {
        proxy_pass http://127.0.0.1:8340;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # Audios del curso y sus transcripciones (opcionales): públicos, porque el kit los enlaza.
    location ~ ^/audios/(modulo-[1-7]\.(mp3|md))$ {
        alias /srv/vibe-tutor/contenido/audios/$1;
        types { audio/mpeg mp3; text/markdown md; }
        charset utf-8;
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include snippets/vibe-tutor-cabeceras.conf;
    }

    # Archivos con hash del build: caché larga; si uno ya no existe, 404 (no el index.html).
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include snippets/vibe-tutor-cabeceras.conf;
    }

    location = /sw.js {
        add_header Cache-Control "no-cache" always;
        include snippets/vibe-tutor-cabeceras.conf;
    }

    location / {
        try_files $uri /index.html;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/__DOMINIO__/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/__DOMINIO__/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = __DOMINIO__) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name __DOMINIO__;
    return 404; # managed by Certbot
}
