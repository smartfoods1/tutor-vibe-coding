# Datos del despliegue que usa deploy/desplegar.sh.
# Copiá este archivo a deploy/despliegue.env (no se versiona) y completalo con lo tuyo.
# Si exportás estas variables en la terminal, pisan a las del archivo.

# Usuario y servidor por SSH, con tu clave SSH ya cargada. Puede ser un alias de ~/.ssh/config.
# Si el usuario no es root, necesita sudo sin contraseña para instalar y reiniciar el servicio.
VIBE_SERVIDOR=root@tu-servidor

# Dominio del curso. Su registro DNS tiene que apuntar al servidor antes de pedir el certificado.
VIBE_DOMINIO=curso.tudominio.com
