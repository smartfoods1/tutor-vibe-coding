# Configuración del backend: la lee Settings (backend/vibe_tutor/config.py).
# En el servidor vive en /etc/vibe-tutor/.env (permisos 640, dueño root, grupo vibe-tutor) y la crea
# deploy/preparar-servidor.sh a partir de este archivo. En tu compu, en un archivo local que indicás
# con VIBE_ENV_FILE (ver docs/desarrollo-local.md y el bloque "Local" al final).
#
# Este archivo no lleva valores reales: nunca subas claves al repo.
# Las líneas sin # son las que tenés que completar (o dejar vacías a propósito). Las que empiezan con
# "# CLAVE=" muestran el valor por defecto: para cambiarlo, sacale el # y poné el tuyo. Una variable
# vacía (CLAVE=) vale lo mismo que no ponerla: rige el valor por defecto.
# Los valores con espacios o con < > van entre comillas.

# --- IA (claves obligatorias salvo con MODO_DEMO=true) ---
# Claude (el tutor de la web): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Gemini (dictado y voz del tutor): https://aistudio.google.com
GEMINI_API_KEY=
# Modelo del tutor y de la voz. Si los cambiás, revisá los precios en backend/vibe_tutor/costos.py.
# MODELO=claude-sonnet-5
# TTS_MODELO=gemini-3.8-flash-tts
# TTS_MODELO_RESPALDO=gemini-2.5-flash-preview-tts
# TTS_VOZ=Charon

# --- Mails (Resend; la clave es obligatoria salvo con MODO_DEMO=true) ---
# El remitente tiene que ser de un dominio verificado en Resend, por ejemplo:
# MAIL_FROM="Mi curso <hola@mail.tudominio.com>"
RESEND_API_KEY=
MAIL_FROM=

# --- Antibots (Cloudflare Turnstile, opcional pero recomendado) ---
# Con TURNSTILE_SECRET vacío el antibots queda apagado: cualquiera puede pedir códigos (siguen los
# límites de abajo). En producción conviene completarlo.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Sesión y administración ---
# Secreto para firmar las sesiones: mínimo 32 caracteres. Generalo con: openssl rand -hex 32
JWT_SECRET=
# Mail de quien administra el curso: entrando con ese mail se ve /admin y llegan los avisos de gasto.
ADMIN_EMAIL=

# --- Quién da el curso ---
# Nombre de quien da el curso, tal como aparece en los textos (reemplaza {{AUTOR}} en contenido/).
# Vacío: los textos dicen "el autor del curso".
AUTOR_NOMBRE=
# Nombre de tu newsletter (por ejemplo, la plataforma donde publicás). Vacío: no se ofrece la
# casilla de novedades en la inscripción y nadie queda anotado.
NEWSLETTER_NOMBRE=

# --- Quién entra al curso ---
# Con true, cada inscripción espera a que la apruebes en /admin: hasta entonces esa persona tiene
# sesión pero no usa el tutor ni la voz, no le llega la bienvenida (sale al aprobar) y a vos te
# llega un aviso por mail, como mucho uno por hora. Sirve para que un link que se viraliza no se
# coma el tope del mes. Los pedidos que nadie aprueba se borran solos a los 90 días. Tu ADMIN_EMAIL
# entra siempre aprobado. Vacío o false: cualquiera que verifica su mail entra directo.
APROBACION_MANUAL=

# --- Siguiente paso al terminar el curso ---
# Con true, cuando un alumno registra su primer link la web le pregunta si tiene un negocio que ya
# vende. Si dice que sí, ve tu texto y una casilla desmarcada para que le avisen cuando abra tu
# siguiente paso. No pongas precios en los textos: el curso no vende. El aviso es un permiso aparte,
# que el alumno ve y saca desde "Mis datos", y esa lista no se exporta. La respuesta se cuenta sin
# guardar quién contestó, y en /admin ves cuántos contestaron, cuántos tienen un negocio y cuántos
# pidieron el aviso. Hacen falta los tres textos, cada uno en una línea: si falta alguno, la función
# queda apagada y /admin dice cuál. Vacío o false: no se pregunta nada. Por ejemplo:
# SIGUIENTE_PASO=true
SIGUIENTE_PASO=
# Cómo se llama tu siguiente paso en los textos legales, con su artículo, porque va después de
# "cuando abra" (reemplaza {{SIGUIENTE_PASO}} en contenido/legal/). Por ejemplo:
# SIGUIENTE_PASO_NOMBRE="el curso de sistemas para negocios"
SIGUIENTE_PASO_NOMBRE=
# La pregunta y el texto que ve el alumno. Por ejemplo:
# SIGUIENTE_PASO_PREGUNTA="¿Tenés un negocio que ya vende?"
# SIGUIENTE_PASO_TEXTO="En marzo abre un curso para construir el sistema que gestiona tu negocio."
SIGUIENTE_PASO_PREGUNTA=
SIGUIENTE_PASO_TEXTO=

# --- Topes de costo del tutor de la web, en US$ ---
# Por defecto: 1 por alumno (en toda su vida) y 50 por mes. Al 80% del tope mensual llega un aviso.
TOPE_ALUMNO_USD=
TOPE_MENSUAL_USD=

# --- Límites de pedidos de código por mail ---
# MAX_CODIGOS_MAIL_HORA=5
# MAX_CODIGOS_IP_HORA=20
# MAX_CODIGOS_DIA=80

# --- Rutas y dominio ---
# Por defecto: /srv/vibe-tutor/data y /srv/vibe-tutor/contenido. DOMINIO sin https://.
DATA_DIR=
CONTENIDO_DIR=
DOMINIO=

# --- Funcionamiento ---
# Aviso de que el curso está en prueba, arriba de todo. Ponelo en false el día que abras la
# inscripción.
# AVISO_PRUEBA=true
# Tarea periódica (recordatorios, aviso del 80%, reintentos de mails y borrado por retención).
# TAREAS_ACTIVAS=true
# Modo demo: el tutor responde con un guion fijo sin llamar a Claude, la voz queda apagada, los
# mails no se mandan (quedan anotados en la base y en el registro) y no hacen falta claves de API.
# Solo para probar en local; nunca en producción.
# MODO_DEMO=false
# Código fijo para entrar sin mandar mails. Solo funciona pidiendo desde la misma compu
# (localhost). Vacío en producción.
DEV_CODIGO_FIJO=

# --- Local ---
# Para probar en tu compu, creá backend/.env.local con estas líneas (sin el #) más un JWT_SECRET,
# un MAIL_FROM y un ADMIN_EMAIL de prueba. Con MODO_DEMO=true no hacen falta las claves de API.
# Paso a paso en docs/desarrollo-local.md.
# DOMINIO=localhost:5173
# DATA_DIR=./data
# CONTENIDO_DIR=../contenido
# TAREAS_ACTIVAS=false
# DEV_CODIGO_FIJO=123456
# MODO_DEMO=true
